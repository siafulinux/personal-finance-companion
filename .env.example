# ---------------------------------------------------------------------------
# Personal Finance Companion - example environment configuration
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
APP_NAME="Personal Finance Companion"
ENVIRONMENT=development
# "production" enables secure cookies and requires a strong secret.
DEBUG=false

# --- Network (loopback by default; change only if you know why) -------------
API_HOST=127.0.0.1
API_PORT=8010
WEB_HOST=127.0.0.1
WEB_PORT=5183
# Comma separated list of origins allowed to call the API (Vite dev proxy avoids CORS).
CORS_ORIGINS=http://127.0.0.1:5183,http://localhost:5183

# --- Database --------------------------------------------------------------
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_dev_password
POSTGRES_DB=finance
DB_PORT=55432
# SQLAlchemy URL. Keep host on loopback.
DATABASE_URL=postgresql+psycopg://finance:finance_dev_password@127.0.0.1:55432/finance

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-secret-key-please-generate-your-own
ACCESS_TOKEN_TTL_MINUTES=720
SESSION_COOKIE_NAME=pfc_session
CSRF_COOKIE_NAME=pfc_csrf
COOKIE_SECURE=false
# Password policy
PASSWORD_MIN_LENGTH=10
# Redact sensitive values from logs (amounts, merchant names are never logged).
LOG_LEVEL=INFO

# --- Financial defaults ----------------------------------------------------
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=America/New_York
# Used when no reliable payday exists.
DEFAULT_SAFE_TO_SPEND_HORIZON_DAYS=14
# Maximum horizon for bill reserves, even if payday is far away.
MAX_SAFE_TO_SPEND_HORIZON_DAYS=45

# --- Demo data -------------------------------------------------------------
# Demo users are flagged and removable; never mix with real data.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=DemoPassword123!
