# ---------------------------------------------------------------------------
# Personal Finance Companion - example environment configuration
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
APP_NAME="Personal Finance Companion"
ENVIRONMENT=development
# "production" enables secure cookies and requires a strong secret.
DEBUG=false

# --- Network (loopback by default; change only if you know why) -------------
API_HOST=127.0.0.1
API_PORT=8010
WEB_HOST=127.0.0.1
WEB_PORT=5183
# Comma separated list of origins allowed to call the API (Vite dev proxy avoids CORS).
CORS_ORIGINS=http://127.0.0.1:5183,http://localhost:5183

# --- Database --------------------------------------------------------------
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance_dev_password
POSTGRES_DB=finance
DB_PORT=55432
# SQLAlchemy URL. Keep host on loopback.
DATABASE_URL=postgresql+psycopg://finance:finance_dev_password@127.0.0.1:55432/finance

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-secret-key-please-generate-your-own
ACCESS_TOKEN_TTL_MINUTES=720
SESSION_COOKIE_NAME=pfc_session
CSRF_COOKIE_NAME=pfc_csrf
COOKIE_SECURE=false
# Password policy
PASSWORD_MIN_LENGTH=10
# Redact sensitive values from logs (amounts, merchant names are never logged).
LOG_LEVEL=INFO

# --- Financial defaults ----------------------------------------------------
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=America/New_York
# Used when no reliable payday exists.
DEFAULT_SAFE_TO_SPEND_HORIZON_DAYS=14
# Maximum horizon for bill reserves, even if payday is far away.
MAX_SAFE_TO_SPEND_HORIZON_DAYS=45

# --- Demo data -------------------------------------------------------------
# Demo users are flagged and removable; never mix with real data.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=DemoPassword123!

# --- Financial connectivity (Plaid) ----------------------------------------
# Sandbox keys from https://dashboard.plaid.com/team/keys. Plaid issues these only to
# an account holder; there is no keyless sandbox. Without them the Plaid adapter is
# still registered (so the UI can say what is missing) but every call is refused, and
# the bundled sandbox institution keeps working.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
# Live verification (backend/scripts/verify_plaid_live.py) creates and revokes real
# sandbox Items, so it refuses to run against any other environment.
# Optional: override the API host (tests point this at a local fake Plaid).
# PLAID_BASE_URL=
# Optional webhook URL. Nothing verifies a webhook signature yet.
# PLAID_WEBHOOK_URL=
# Dedicated key for encrypting provider access tokens at rest. When unset, one is
# derived from SECRET_KEY with HKDF, which ties stored ciphertext to that secret.
# PROVIDER_ENCRYPTION_KEY=

# --- TLS front (Caddy) -----------------------------------------------------
# scripts/gen-tls issues one project CA plus a server certificate covering
# loopback, 10.0.2.2 (emulator -> host) and the LAN address below. Set the
# address this machine is reached on before generating certificates.
PFC_LAN_IP=192.168.1.5
#
# When the app is served through the TLS front (scripts/install-service,
# https://<host>:8443) also set COOKIE_SECURE=true above: the session cookie is
# then only sent over HTTPS, and the browser refuses to keep it on plain HTTP.
# Leave it false only for the legacy ./scripts/app start path over loopback.

# --- Off-site backups ------------------------------------------------------
# The weekly routine (scripts/backup-routine) copies each verified dump to one of
# these, checksums it at the destination and only then renames it into place. Set
# one, not both. A destination on the same filesystem as backups/ is refused,
# because that is what an unmounted external disk looks like.
# PFC_BACKUP_OFFSITE_DIR=/mnt/storage/pfc-backups
# PFC_BACKUP_OFFSITE_RSYNC=user@host:/srv/pfc-backups
# Extra ssh options for the rsync destination: port, identity, jump host.
# PFC_BACKUP_OFFSITE_SSH_OPTS="-p 2222 -i ~/.ssh/pfc_backup"
# Seconds before a network call is abandoned (default 600).
# PFC_BACKUP_OFFSITE_TIMEOUT=600
# Dumps to keep off-site (default: PFC_BACKUP_KEEP).
# PFC_BACKUP_OFFSITE_KEEP=12
# Check the destination without taking a backup: scripts/backup-routine --preflight

# --- Phase 2: institution connectivity -------------------------------------
# Sandbox is always available and needs no credentials. A real Plaid account is
# optional; set all three to enable the provider. Values live in .env only and
# are never sent to a browser or logged.
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENVIRONMENT=sandbox
# Optional overrides for testing against a mock or a proxy.
# PLAID_BASE_URL=
# PLAID_WEBHOOK_URL=
# Sync tuning: page size, page cap per run, and the floor between two attempts
# for the same institution (the timer runs more often than this on purpose).
SYNC_PAGE_SIZE=100
SYNC_MAX_PAGES=50
SYNC_MIN_INTERVAL_MINUTES=60

# --- Phase 2: AI assistant (optional) --------------------------------------
# The app is fully usable with AI disabled: answers fall back to the
# deterministic engine and the assistant UI says so. No financial figures are
# sent anywhere unless a provider is configured AND the user opts in.
AI_PROVIDER=disabled
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
