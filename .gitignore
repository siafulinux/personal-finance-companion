__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# Android / Gradle
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.apk
*.aab
android/tooling/

# Data & backups (never commit real financial data)
data/
backups/
!data/.gitkeep
!backups/.gitkeep

# Logs / runtime
logs/
*.log
.pids/
*.pid

# Generated evidence (screenshots may show real financial data)
artifacts/

# Local build toolchains (Gradle distribution, project-local JDK)
.tools/

# OS
.DS_Store
Thumbs.db
