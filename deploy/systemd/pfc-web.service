[Unit]
Description=Personal Finance Companion web (Vite)
Documentation=file://@ROOT@/docs/android.md
After=network-online.target pfc-api.service
Wants=network-online.target
PartOf=pfc.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@ROOT@/web
EnvironmentFile=-@ROOT@/.env
Environment=NODE_ENV=development
ExecStart=/usr/bin/npm run dev
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
StandardOutput=append:@ROOT@/logs/web.log
StandardError=append:@ROOT@/logs/web.log

[Install]
WantedBy=pfc.target
