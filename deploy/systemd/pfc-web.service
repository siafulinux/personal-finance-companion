[Unit]
Description=Personal Finance Companion web UI (Vite dev server)
After=network-online.target pfc-api.service
Wants=network-online.target
PartOf=pfc.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/lib/pfc/pfc-run web
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfc.target
