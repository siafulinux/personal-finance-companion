[Unit]
Description=Personal Finance Companion API (uvicorn)
After=network-online.target docker.service
Wants=network-online.target
PartOf=pfc.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=%h/.local/lib/pfc/pfc-run wait-db
ExecStartPre=%h/.local/lib/pfc/pfc-run migrate
ExecStart=%h/.local/lib/pfc/pfc-run api
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfc.target
