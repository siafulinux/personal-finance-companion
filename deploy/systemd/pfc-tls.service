[Unit]
Description=Personal Finance Companion TLS front (Caddy, internal CA)
After=network-online.target pfc-api.service pfc-web.service
Wants=network-online.target pfc-api.service pfc-web.service
PartOf=pfc.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/lib/pfc/pfc-run tls
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=pfc.target
