# ---------------------------------------------------------------------------
# Personal Finance Companion — self-hosted deployment settings
# Copy to .env and edit. `docker compose` reads this file automatically.
# ---------------------------------------------------------------------------

# --- Required secrets ------------------------------------------------------
# Generate your own; never ship the placeholders.
#   openssl rand -base64 36   -> SECRET_KEY      (32+ characters)
#   openssl rand -base64 24   -> POSTGRES_PASSWORD
# Changing POSTGRES_PASSWORD after the database exists does not alter the
# existing role password, so set it before the first start.
POSTGRES_PASSWORD=change-me-before-first-start
SECRET_KEY=change-me-before-first-start

# --- Database --------------------------------------------------------------
POSTGRES_USER=finance
POSTGRES_DB=finance
APP_TIMEZONE=America/New_York

# --- Deployment mode -------------------------------------------------------
# lan         trusted local network over plain HTTP (default). Cookies are not
#             flagged Secure, because a Secure cookie is never sent over HTTP.
# production  public deployment behind HTTPS. Requires COOKIE_SECURE=true and a
#             SECRET_KEY of 32+ characters, otherwise the API refuses to start.
ENVIRONMENT=lan
COOKIE_SECURE=false

# --- Addresses and ports ---------------------------------------------------
# Host ports for the reverse proxy. 8088/8448 avoid clashing with services that
# already use 80/443 on this machine; use 80/443 on a dedicated host.
PFC_HTTP_PORT=8088
PFC_HTTPS_PORT=8448
# Host-side port for on-host database diagnostics. It is published on 127.0.0.1
# only -- reachable with psql/pg_dump from this machine, never from the LAN.
PFC_DB_PORT=5433
# What the proxy serves:
#   :80                  trusted LAN over HTTP (default)
#   finance.example.com  public HTTPS with an automatic certificate
#   https://pfc.lan      HTTPS with Caddy's internal CA (LAN, needs trust)
PFC_SITE_ADDRESS=:80
# Only set this when the address clients should use differs from the one they
# typed (behind a tunnel or NAT). Empty means "derive it from the request".
PUBLIC_BASE_URL=
# Host header allowlist. "*" is required on a LAN reached by IP address; set the
# real domain on a public install.
TRUSTED_HOSTS=*

# --- Sessions and logging --------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=720
LOG_LEVEL=INFO

# Names this installation. Change it to run a second, isolated stack on the same
# host (with different PFC_HTTP_PORT and its own .env directory).
COMPOSE_PROJECT_NAME=pfc

# --- Background worker -----------------------------------------------------
# How often the worker looks for institutions due a sync (seconds).
WORKER_SYNC_INTERVAL_SECONDS=300

# --- Optional integrations -------------------------------------------------
# Bank connectivity. Credentials are only needed to connect a real institution;
# the bundled simulated institution works without them, and both providers can
# also be configured later on the Admin → Providers screen (that value wins).
#
# Encryption key for provider credentials at rest. Generate with
#   openssl rand -base64 32
# and set it before the first provider credential is saved: without it the key
# is derived from SECRET_KEY, so rotating SECRET_KEY would make stored provider
# credentials unreadable. Changing it later also makes them unreadable, so back
# it up with the database.
PROVIDER_ENCRYPTION_KEY=

# Teller (primary). Application id is public; the certificate and key are
# required outside sandbox. Paste PEM contents, or mount them and give paths.
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=sandbox
TELLER_CERTIFICATE=
TELLER_PRIVATE_KEY=
TELLER_SIGNING_KEY=
TELLER_PROVIDER_ENABLED=true

# Plaid (fallback).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
PLAID_PROVIDER_ENABLED=true

# Per-institution automatic selection. Turn off to pin the highest-priority
# ready provider; the admin screen can change it without editing this file.
PROVIDER_AUTO_SELECT=true
# The simulated institution, used for demos and tests.
SANDBOX_PROVIDER_ENABLED=true
