# syntax=docker/dockerfile:1.7
# Production API image: FastAPI + the deterministic financial engine.
# The same image runs the API and the background worker (different commands).
FROM python:3.12-slim AS api

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# curl is used by the container health check; nothing else is needed at runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first, so editing application code does not reinstall the world.
COPY backend/pyproject.toml ./pyproject.toml
COPY backend/app ./app
# Verification tools that must see the deployment's own database and provider
# configuration (scripts/verify_plaid_live.py drives the live sandbox check).
COPY backend/scripts ./scripts
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini

RUN pip install --upgrade pip && pip install .

# Run as an unprivileged user. /app stays read-only at runtime; nothing writes
# into the image (uploads are processed in memory, logs go to stdout).
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin pfc \
    && chown -R pfc:pfc /app
USER pfc

COPY --chown=pfc:pfc deploy/docker/api-entrypoint.sh /usr/local/bin/api-entrypoint
RUN chmod +x /usr/local/bin/api-entrypoint

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/api-entrypoint"]
# --proxy-headers trusts X-Forwarded-* from the proxy so cookies, HSTS and the
# advertised URLs use the scheme a client actually used.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*", \
     "--no-server-header"]
