# syntax=docker/dockerfile:1.7
# The React/Vite app is built once, then served as static files by nginx.
FROM node:22-alpine AS build

WORKDIR /app

# Install exactly what the lockfile pins before copying sources, so source edits
# do not invalidate the dependency layer.
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY web/ ./
# `tsc -b && tsc -p tsconfig.e2e.json && vite build` — the type checks, including
# the browser-test specs, are part of the build on purpose.
RUN npm run build


FROM nginx:1.27-alpine AS runtime

# Our config replaces the default site; the stock nginx.conf stays, so nginx
# still runs as a normal foreground process.
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
