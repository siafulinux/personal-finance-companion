#!/usr/bin/env bash
# Refuse to push a tag whose commit has no passing CI run.
#
# Tag pushes do not start CI (see .github/workflows/ci.yml), so without this
# check a release tag could name a commit that never went green -- or that never
# ran at all -- and nothing downstream would notice.
#
# Branch pushes are left alone: they trigger CI themselves.
#
# Install with:  git config core.hooksPath .githooks
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
verify="$repo_root/scripts/verify-ci"
if [ ! -x "$verify" ]; then
  echo "pre-push: $verify is missing or not executable; cannot verify tags." >&2
  exit 1
fi

failed=0
# stdin: <local ref> <local sha> <remote ref> <remote sha>, one push per line.
while read -r local_ref local_sha _remote_ref _remote_sha; do
  case "$local_ref" in
    refs/tags/*) ;;
    *) continue ;;
  esac
  # An all-zero local sha is a deletion; there is nothing to verify.
  if [ -z "${local_sha//0/}" ]; then
    continue
  fi
  tag=${local_ref#refs/tags/}
  if "$verify" "$local_sha"; then
    continue
  fi
  failed=1
  printf '\npre-push: refusing to push tag %s.\n' "$tag" >&2
  printf 'pre-push: push that commit as a branch first and let CI pass, then retry.\n' >&2
  printf 'pre-push: check by hand with "scripts/verify-ci %s".\n\n' "$local_sha" >&2
done

exit "$failed"
