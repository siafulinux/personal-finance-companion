#!/usr/bin/env bash
# Install and start the supervised units for this workspace.
#
# Two things get installed, and neither of them contains the workspace path:
#
#   ~/.local/lib/pfc/pfc-run        launcher (a copy; survives moving the tree)
#   ~/.config/systemd/user/pfc.*    units that only call that launcher
#
# The workspace location lives in a single symlink,
# ~/.config/pfc/workspace. Moving the checkout therefore means running
# scripts/relocate from the new location, not editing units.
#
# The legacy single oneshot wrapper (pfc.service, which only started detached
# children and never supervised them) is retired in place: it is stopped,
# disabled and renamed to pfc.service.disabled-oneshot so it stays inspectable.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pfc"
LAUNCHER_DIR="$HOME/.local/lib/pfc"
POINTER="$CONF_DIR/workspace"

mkdir -p "$UNIT_DIR" "$CONF_DIR" "$LAUNCHER_DIR" "$ROOT/logs"

if ! command -v caddy >/dev/null 2>&1; then
  echo "Caddy is required for the TLS front. Install caddy first." >&2
  exit 1
fi

# Stop any children the old wrapper (or ./scripts/app) left behind: they would
# hold the ports the supervised units need.
systemctl --user stop pfc.service >/dev/null 2>&1 || true
systemctl --user disable pfc.service >/dev/null 2>&1 || true
if [[ -f "$UNIT_DIR/pfc.service" ]]; then
  mv "$UNIT_DIR/pfc.service" "$UNIT_DIR/pfc.service.disabled-oneshot"
  echo "Retired legacy unit -> $UNIT_DIR/pfc.service.disabled-oneshot"
fi
"$ROOT/scripts/app" stop >/dev/null 2>&1 || true

# 1. The launcher: a copy at a fixed path, so a moved workspace cannot break it.
install -m 0755 "$ROOT/deploy/bin/pfc-run" "$LAUNCHER_DIR/pfc-run"

# 2. The pointer: the one place the workspace path is recorded.
ln -sfn "$ROOT" "$POINTER"

# 3. The units: static files, copied verbatim. No path substitution.
for unit in pfc-api.service pfc-web.service pfc-tls.service pfc.target \
  pfc-backup.service pfc-backup.timer pfc-sync.service pfc-sync.timer; do
  install -m 0644 "$ROOT/deploy/systemd/$unit" "$UNIT_DIR/$unit"
done

chmod +x scripts/wait-for-db scripts/backup-routine

systemctl --user daemon-reload
# Enable the units themselves as well as the target, so each is individually
# enabled for boot and not only pulled in by the target's Wants=.
systemctl --user enable pfc.target pfc-api.service pfc-web.service pfc-tls.service >/dev/null
# The backup service has no [Install] section: the timer is what gets enabled,
# and it must be started as well, or nothing is scheduled until the next login.
systemctl --user enable pfc-backup.timer >/dev/null
systemctl --user start pfc-backup.timer
systemctl --user enable pfc-sync.timer >/dev/null
systemctl --user start pfc-sync.timer
# A target restart does not restart its members; stop then start the target.
systemctl --user stop pfc.target >/dev/null 2>&1 || true
systemctl --user start pfc.target

echo "Launcher : $LAUNCHER_DIR/pfc-run"
echo "Workspace: $POINTER -> $(readlink "$POINTER")"
echo "Units    : $UNIT_DIR/pfc-{api,web,tls}.service, pfc.target"
echo "Backup   : $UNIT_DIR/pfc-backup.{service,timer}; next run: systemctl --user list-timers pfc-backup.timer"
echo "Sync     : $UNIT_DIR/pfc-sync.{service,timer}; next run: systemctl --user list-timers pfc-sync.timer"
echo "Check    : systemctl --user status pfc.target pfc-api.service pfc-web.service pfc-tls.service"
