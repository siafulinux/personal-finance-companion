#!/usr/bin/env bash
# Export the project CA into the Android app so the app can trust the LAN server
# without disabling certificate verification.
#
# The server certificate is signed by certs/pfc-ca.crt (see scripts/gen-tls),
# NOT by Caddy's built-in local authority, so that is the certificate the app
# must trust. Copying Caddy's own root here would leave the app unable to verify
# the server.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

CA_SRC="certs/pfc-ca.crt"
SRV_CRT="certs/pfc-server.crt"
DEST="android/app/src/main/res/raw/pfc_ca.crt"

if [[ ! -f "$CA_SRC" ]]; then
  echo "No project CA at $CA_SRC." >&2
  echo "Run scripts/gen-tls first." >&2
  exit 1
fi

# Refuse to ship a CA that does not actually vouch for the server certificate.
if [[ -f "$SRV_CRT" ]]; then
  if ! openssl verify -CAfile "$CA_SRC" "$SRV_CRT" >/dev/null 2>&1; then
    echo "$SRV_CRT is not signed by $CA_SRC; regenerate with scripts/gen-tls." >&2
    exit 1
  fi
fi

mkdir -p "$(dirname "$DEST")"
cp "$CA_SRC" "$DEST"
chmod 644 "$DEST"
echo "Exported CA to $DEST"
echo "Fingerprint:"
openssl x509 -in "$DEST" -noout -fingerprint -sha256
