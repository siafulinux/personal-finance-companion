#!/usr/bin/env bash
# Create an annotated release tag, but only for a commit CI has passed.
#
#   scripts/tag-release v0.6.0
#   scripts/tag-release v0.6.0 --message "Release 0.6.0"
#   scripts/tag-release v0.6.0 <commit>       # tag an older, already-green commit
#
# The tag is not created when the check fails, so a refused release leaves no
# half-finished ref behind. .githooks/pre-push enforces the same rule for tags
# made by hand with `git tag`.
set -euo pipefail

usage() {
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

[ $# -ge 1 ] || usage
tag=$1
shift

message=""
target=HEAD
while [ $# -gt 0 ]; do
  case "$1" in
    -m|--message)
      [ $# -ge 2 ] || usage
      message=$2
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    *)
      target=$1
      shift
      ;;
  esac
done

case "$tag" in
  v[0-9]*) ;;
  *)
    printf 'tag-release: tags in this repository look like v1.2.3 (got "%s").\n' "$tag" >&2
    exit 2
    ;;
esac

if git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null; then
  printf 'tag-release: tag %s already exists.\n' "$tag" >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
"$repo_root/scripts/verify-ci" "$target" || {
  printf 'tag-release: not tagging %s; its commit has no passing CI run.\n' "$tag" >&2
  exit 1
}

[ -n "$message" ] || message="Release $tag"
git tag -a "$tag" -m "$message" "$target"
printf 'tag-release: created annotated tag %s on %s.\n' \
  "$tag" "$(git rev-parse --short "${tag}^{commit}")"
printf 'tag-release: push it with "git push origin %s".\n' "$tag"
